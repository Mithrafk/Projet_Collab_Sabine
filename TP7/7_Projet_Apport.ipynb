    "- 34 nutriment32 NUM Magnésium (mg/j)\n",
    "- 35 nutriment33 NUM Phosphore (mg/j)\n",
    "- 36 nutriment34 NUM Potassium (mg/j)\n",
    "- 37 nutriment35 NUM Calcium (mg/j)\n",
    "1. Vitamine\n",
    "- 53 nutriment51 NUM Vitamine C (mg/j)\n",
    "- 54 nutriment52 NUM Vitamine D (μg/j)\n",
